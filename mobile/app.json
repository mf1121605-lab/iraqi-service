{
  "expo": {
    "name": "منصة الخدمات العراقية",
    "slug": "iraqi-services",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "iraqi-service",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d1117"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.iraqiservice.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "يستخدم التطبيق الميكروفون لتسجيل الرسائل الصوتية في المحادثات.",
        "NSPhotoLibraryUsageDescription": "يستخدم التطبيق مكتبة الصور لإرفاق صور وفيديوهات في المحادثات والمنشورات."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d1117"
      },
      "package": "com.iraqiservice.app",
      "versionCode": 8,
      "permissions": [
        "NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "iraqi-service.vercel.app" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#e6ab2c",
          "sounds": []
        }
      ],
      "./plugins/withGradleVersion"
    ],
    "runtimeVersion": "1.0.0",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "01765596-0307-4934-b259-c1ae8e1c482b"
      }
    },
    "owner": "boss_m.f",
    "updates": {
      "url": "https://u.expo.dev/01765596-0307-4934-b259-c1ae8e1c482b",
      "checkAutomatically": "NEVER"
    }
  }
}
